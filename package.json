{
  "name": "campaign-lego",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:server": "npm run dev -w @cl/server",
    "dev:web": "npm run dev -w @cl/web",
    "build": "npm run build -w @cl/shared && npm run build -w @cl/web && npm run build -w @cl/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build -w @cl/shared && npm run test --workspaces --if-present",
    "migrate": "npm run migrate -w @cl/server",
    "create-admin": "npm run create-admin -w @cl/server --",
    "start": "npm run start -w @cl/server"
  }
}
