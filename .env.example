# Copy to .env (never commit .env). Server-side only.
PORT=3000
# Public address of the app. Invitation links are built from this.
# Local: http://localhost:3000   Hosted: https://<your-service>.onrender.com
APP_BASE_URL=http://localhost:3000
# Neon connection string (use a separate dev database/branch locally)
DATABASE_URL=
# Sentry DSN (optional until the Sentry account exists)
SENTRY_DSN=
# 64 hex characters (32 random bytes). Encrypts two-factor secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Local and hosted apps that share a database MUST use the same value. Losing it forces every user to re-enrol 2FA.
APP_SECRET_KEY=
